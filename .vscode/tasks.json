{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "build",
                "-S",
                ".",
                "-G",
                "Ninja",
                "-DCMAKE_C_COMPILER=C:/mingw64/bin/gcc.exe",
                "-DCMAKE_CXX_COMPILER=C:/mingw64/bin/g++.exe",
                "-DCMAKE_PREFIX_PATH=C:/SDL2"
            ],
            "options": {
                "env": {
                    "PATH": "C:\\mingw64\\bin;${env:PATH}"
                }
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "cmake --build build -j12",
            "options": {
                "env": {
                    "PATH": "C:\\mingw64\\bin;${env:PATH}"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Run Demo",
            "type": "shell",
            "command": "${workspaceFolder}\\run_demo.bat",
            "dependsOn": "Build",
            "problemMatcher": []
        }
    ]
}